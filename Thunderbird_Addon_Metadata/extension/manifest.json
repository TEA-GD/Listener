{
  "manifest_version": 2,
  "name": "Listener Mail Metadata Only",
  "version": "1.0.0",
  "description": "Report only date, sender, recipients and attachment names; no subjects or message bodies.",
  "browser_specific_settings": {
    "gecko": {
      "id": "listener-mail-metadata@tea-gd.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Listener mail alert settings"
  }
}
