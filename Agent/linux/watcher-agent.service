[Unit]
Description=Watcher SIEM Connection Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/watcher-agent --config /etc/watcher-agent/agent.json
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/watcher-agent

[Install]
WantedBy=multi-user.target
