<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WatcherAgent</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
<ItemGroup><Compile Include="../../../Shared/DeviceCategories.cs" Link="DeviceCategories.cs" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../../../Shared/NetworkContext.ps1" LogicalName="Watcher.NetworkContext.ps1" /></ItemGroup>
<ItemGroup><Compile Include="../../../Shared/MailPayload.cs" Link="MailPayload.cs" /></ItemGroup>
</Project>
