<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(BuildForLinux)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(BuildForLinux)' == 'true'">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WatcherCollector</AssemblyName>
    <RuntimeIdentifier Condition="'$(BuildForLinux)' != 'true'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(BuildForLinux)' == 'true'">linux-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../../Shared/MailDatabaseSchema.cs" Link="MailDatabaseSchema.cs" /></ItemGroup>
<ItemGroup><Compile Include="../../../Shared/DeviceCategories.cs" Link="DeviceCategories.cs" /></ItemGroup>
<ItemGroup><Compile Include="../../../Shared/GuiReadModel.cs" Link="GuiReadModel.cs" /></ItemGroup>
<ItemGroup><Compile Include="../../../Shared/NetworkContextSchema.cs" Link="NetworkContextSchema.cs" /></ItemGroup>
</Project>
