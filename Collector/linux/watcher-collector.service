[Unit]
Description=Watcher event Collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=watcher-collector
Group=watcher-collector
WorkingDirectory=/opt/watcher-collector
ExecStart=/opt/watcher-collector/WatcherCollector --config /etc/watcher-collector/collector.json
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/watcher-collector/.net
StateDirectory=watcher-collector
StateDirectoryMode=0750
LogsDirectory=watcher-collector
LogsDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/watcher-collector /var/log/watcher-collector

[Install]
WantedBy=multi-user.target
