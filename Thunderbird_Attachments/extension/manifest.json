{
  "manifest_version": 2,
  "name": "Listener Attachment Mail",
  "version": "1.0.0",
  "description": "Report attachment-only arrival metadata through the local Listener Agent; no subject, body or attachment contents.",
  "browser_specific_settings": {
    "gecko": {
      "id": "listener-mail-attachments@tea-gd.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage",
    "unlimitedStorage",
    "alarms",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Attachment mail settings"
  }
}
